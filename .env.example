# RazorRisk Environment Configuration Example
# Copy this file to .env and fill in your Test Mode credentials.
# NEVER commit actual secrets to version control.

RAZORRISK_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Razorpay Test Mode Credentials (get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Local Database Configuration
SQLITE_DB_PATH=storage/audit.db

# Production Model Path
MODEL_ARTIFACT_PATH=models/razorrisk_random_forest_pipeline.joblib
